[Unit]
Description=Bevestigde Nederlandse Kodi-ondertitelvertaler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/radxa/subtitle-translator
ExecStart=/usr/bin/python3 /home/radxa/subtitle-translator/subtitle_translator.py
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
Nice=10
MemoryMax=512M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Amsterdam
Environment=WATCH_DIR=/mnt/storage/subtitles
Environment=POLL_SECONDS=5
Environment=CODEX_BINARY=/home/radxa/.local/bin/codex
Environment=CODEX_MODEL=gpt-5.6-luna
Environment=CODEX_REASONING_EFFORT=low
Environment=CODEX_FALLBACK_MODEL=gpt-5.6-terra
Environment=CODEX_FALLBACK_REASONING_EFFORT=low
Environment=CODEX_TIMEOUT=1800
Environment=BATCH_SIZE=5000
Environment=TRANSLATION_BATCH_SIZE=250
Environment=CODEX_WORK_DIR=/home/radxa/.local/share/subtitle-translator/codex-workspace

[Install]
WantedBy=default.target
