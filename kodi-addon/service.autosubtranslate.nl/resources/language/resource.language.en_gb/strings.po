# Kodi Media Center language file
msgid ""
msgstr ""
"Project-Id-Version: Automatic Dutch Subtitles\n"
"Language: en_GB\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#32000"
msgid "General"
msgstr "General"

msgctxt "#32001"
msgid "Controlled subtitle folder"
msgstr "Controlled subtitle folder"

msgctxt "#32002"
msgid "Kodi and the Radxa must both be able to read and write this folder."
msgstr "Kodi and the Radxa must both be able to read and write this folder."

msgctxt "#32003"
msgid "Automatically search OpenSubtitles for English subtitles"
msgstr "Automatically search OpenSubtitles for English subtitles"

msgctxt "#32004"
msgid "Requires the official OpenSubtitles.com add-on. Downloads one English SRT per playback, then asks before translation. Downloads count towards your OpenSubtitles quota, even if you decline translation."
msgstr "Requires the official OpenSubtitles.com add-on. Downloads one English SRT per playback, then asks before translation. Downloads count towards your OpenSubtitles quota, even if you decline translation."

msgctxt "#32005"
msgid "Subtitle synchronization"
msgstr "Subtitle synchronization"

msgctxt "#32006"
msgid "Synchronize with the video audio before translation"
msgstr "Synchronize with the video audio before translation"

msgctxt "#32007"
msgid "Disabled until a secure Radxa synchronization server, certificate fingerprint and access token are configured. Requires a direct HTTP(S) video stream. A synchronization error stops the job instead of translating without synchronization."
msgstr "Disabled until a secure Radxa synchronization server, certificate fingerprint and access token are configured. Requires a direct HTTP(S) video stream. A synchronization error stops the job instead of translating without synchronization."

msgctxt "#32008"
msgid "Secure synchronization server"
msgstr "Secure synchronization server"

msgctxt "#32009"
msgid "HTTPS address of the Radxa reference service. After confirmation, the current video link is sent privately to this server to analyze its audio."
msgstr "HTTPS address of the Radxa reference service. After confirmation, the current video link is sent privately to this server to analyze its audio."

msgctxt "#32010"
msgid "Certificate SHA-256 fingerprint"
msgstr "Certificate SHA-256 fingerprint"

msgctxt "#32011"
msgid "Copy the 64-character SHA-256 fingerprint from the Radxa setup. Kodi checks it before sending the access token or video link."
msgstr "Copy the 64-character SHA-256 fingerprint from the Radxa setup. Kodi checks it before sending the access token or video link."

msgctxt "#32012"
msgid "Private synchronization access token"
msgstr "Private synchronization access token"

msgctxt "#32013"
msgid "Use the access token created by the Radxa setup. It stays in Kodi settings; it is never written to the shared subtitle folder."
msgstr "Use the access token created by the Radxa setup. It stays in Kodi settings; it is never written to the shared subtitle folder."
