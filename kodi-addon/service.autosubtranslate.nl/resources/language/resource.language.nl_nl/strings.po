# Kodi Media Center language file
msgid ""
msgstr ""
"Project-Id-Version: Automatische Nederlandse Ondertitels\n"
"Language: nl_NL\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgctxt "#32000"
msgid "General"
msgstr "Algemeen"

msgctxt "#32001"
msgid "Controlled subtitle folder"
msgstr "Gecontroleerde ondertitelmap"

msgctxt "#32002"
msgid "Kodi and the Radxa must both be able to read and write this folder."
msgstr "Kodi en de Radxa moeten deze map allebei kunnen lezen en beschrijven."

msgctxt "#32003"
msgid "Automatically search OpenSubtitles for English subtitles"
msgstr "Automatisch Engelse ondertitels zoeken via OpenSubtitles"

msgctxt "#32004"
msgid "Requires the official OpenSubtitles.com add-on. Downloads one English SRT per playback, then asks before translation. Downloads count towards your OpenSubtitles quota, even if you decline translation."
msgstr "Vereist de officiële OpenSubtitles.com-add-on. Downloadt per afspeelbeurt één Engelse SRT en vraagt daarna om toestemming voor vertaling. De download telt mee voor je OpenSubtitles-limiet, ook als je de vertaling weigert."

msgctxt "#32005"
msgid "Subtitle synchronization"
msgstr "Ondertitels synchroniseren"

msgctxt "#32006"
msgid "Synchronize with the video audio before translation"
msgstr "Eerst synchroniseren met de filmaudio, daarna vertalen"

msgctxt "#32007"
msgid "Disabled until a secure Radxa synchronization server, certificate fingerprint and access token are configured. Requires a direct HTTP(S) video stream. A synchronization error stops the job instead of translating without synchronization."
msgstr "Staat standaard uit. Stel eerst de beveiligde Radxa-synchronisatieserver, certificaatvingerafdruk en toegangstoken in. Vereist een directe HTTP(S)-videostream. Bij een synchronisatiefout stopt de opdracht; er wordt niet zonder synchronisatie vertaald."

msgctxt "#32008"
msgid "Secure synchronization server"
msgstr "Beveiligde synchronisatieserver"

msgctxt "#32009"
msgid "HTTPS address of the Radxa reference service. After confirmation, the current video link is sent privately to this server to analyze its audio."
msgstr "HTTPS-adres van de Radxa-referentieservice. Na bevestiging wordt de huidige videolink privé naar deze server gestuurd om de audio te analyseren."

msgctxt "#32010"
msgid "Certificate SHA-256 fingerprint"
msgstr "SHA-256-vingerafdruk van het certificaat"

msgctxt "#32011"
msgid "Copy the 64-character SHA-256 fingerprint from the Radxa setup. Kodi checks it before sending the access token or video link."
msgstr "Kopieer de SHA-256-vingerafdruk van 64 tekens uit de Radxa-installatie. Kodi controleert deze voordat het toegangstoken of de videolink wordt verstuurd."

msgctxt "#32012"
msgid "Private synchronization access token"
msgstr "Privétoegangstoken voor synchronisatie"

msgctxt "#32013"
msgid "Use the access token created by the Radxa setup. It stays in Kodi settings; it is never written to the shared subtitle folder."
msgstr "Gebruik het toegangstoken uit de Radxa-installatie. Het blijft in de Kodi-instellingen en komt nooit in de gedeelde ondertitelmap."
